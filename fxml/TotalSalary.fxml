<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="575.0" prefWidth="1100.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #e3f2fd);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.TotalSalaryController">
   <children>
      <Text layoutX="365.0" layoutY="223.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Enter Club Name:" />
      <TextField fx:id="clubNameField" layoutX="518.0" layoutY="204.0" promptText="Club Name" style="-fx-border-color: #90caf9; -fx-border-width: 2; -fx-border-radius: 5;" />
      <Label layoutX="381.0" layoutY="275.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e88e5;" text="Total Salary:" />
      <Label fx:id="totalSalaryLabel" layoutX="515.0" layoutY="275.0" prefHeight="17.0" prefWidth="163.0" style="-fx-font-size: 14px; -fx-text-fill: #1e88e5;" />
      <Button layoutX="546.0" layoutY="344.0" onAction="#handleCalculateSalary" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Calculate" />
      <Button layoutX="517.0" layoutY="418.0" mnemonicParsing="false" onAction="#returnToMainMenu" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Return to Main Menu" />
      <Text layoutX="444.0" layoutY="89.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Search Club Salary">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
      </Text>
   </children>
</AnchorPane>
