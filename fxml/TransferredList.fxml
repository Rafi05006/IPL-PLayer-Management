            <Label fx:id="playerName" layoutX="10.0" layoutY="180.0" prefWidth="280.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e88e5; -fx-alignment: center;" text="Player Name" />
            <Label fx:id="playerPosition" layoutX="10.0" layoutY="260.0" prefWidth="280.0" style="-fx-font-size: 14px; -fx-text-fill: #1e88e5; -fx-alignment: center;" text="Position" />
            <Label fx:id="playerClub" layoutX="10.0" layoutY="290.0" prefWidth="280.0" style="-fx-font-size: 14px; -fx-text-fill: #1e88e5; -fx-alignment: center;" text="Club" />
         </children>
      </AnchorPane>

      <Button fx:id="acceptButton" layoutX="100.0" layoutY="480.0" onAction="#handleAcceptRequest" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Buy Player" />
      <Button fx:id="refreshButton" layoutX="300.0" layoutY="480.0" onAction="#handleRefresh" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Refresh" />
      <Button layoutX="500.0" layoutY="480.0" onAction="#returnToClub" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Back" />
