            <TableColumn fx:id="clubColumn" prefWidth="150" text="Current Club" />
            <TableColumn fx:id="transferClubColumn" prefWidth="150" text="Value" />
            <TableColumn fx:id="statusColumn" prefWidth="148.0" text="Status" />
         </columns>
      </TableView>

      <AnchorPane layoutX="690.0" layoutY="100.0" prefHeight="300.0" prefWidth="300.0" style="-fx-background-color: white; -fx-border-color: #90caf9; -fx-border-width: 2; -fx-border-radius: 5;">
         <children>
            <ImageView fx:id="playerImage" fitHeight="150.0" fitWidth="150.0" layoutX="75.0" layoutY="20.0" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.25), 10, 0.5, 0, 0);" />
            <ImageView fx:id="clubImage" fitHeight="50.0" fitWidth="50.0" layoutX="10.0" layoutY="200.0" preserveRatio="true" />
