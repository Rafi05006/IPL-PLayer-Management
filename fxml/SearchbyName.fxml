<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="575.0" prefWidth="1100.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #e3f2fd);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.searchbyNameController">
   <children>
      <Text layoutX="392.0" layoutY="268.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Player Name:" />
      <TextField fx:id="playerName" layoutX="513.0" layoutY="248.0" style="-fx-border-color: #90caf9; -fx-border-width: 2; -fx-border-radius: 5;" />
      <Button fx:id="searchButton" layoutX="545.0" layoutY="340.0" mnemonicParsing="false" onAction="#startSearchingbyname" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Search" />
      <Button layoutX="503.0" layoutY="407.0" mnemonicParsing="false" onAction="#returntoMainMenu" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Return to Main Menu" />
      <Text layoutX="457.0" layoutY="84.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Search By Name" />
   </children>
</AnchorPane>
