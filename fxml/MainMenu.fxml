<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="575.0" prefWidth="732.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #e3f2fd);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.MainMenuController">
    <children>
        <MenuBar layoutY="97.0" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-border-color: #1e88e5; -fx-border-width: 2; -fx-border-radius: 5;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <menus>
                <Menu mnemonicParsing="false" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Search Player">
                    <items>
                        <MenuItem fx:id="searchByname" mnemonicParsing="false" onAction="#enterSearchPlayer" style="-fx-text-fill: #1e88e5;" text="By Name" />
                        <MenuItem mnemonicParsing="false" onAction="#searchByclubandcountry" style="-fx-text-fill: #1e88e5;" text="By Club and Country" />
                        <MenuItem mnemonicParsing="false" onAction="#searchByposition" style="-fx-text-fill: #1e88e5;" text="By Position" />
                        <MenuItem mnemonicParsing="false" onAction="#searchBysalaryrange" style="-fx-text-fill: #1e88e5;" text="By Salary Range" />
                        <MenuItem mnemonicParsing="false" onAction="#searchCountrywise" style="-fx-text-fill: #1e88e5;" text="Country-Wise Player Count" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Search Club">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#PressingSalary" style="-fx-text-fill: #1e88e5;" text="Player(s) with the maximum salary of a club" />
                        <MenuItem mnemonicParsing="false" onAction="#PressingAge" style="-fx-text-fill: #1e88e5;" text="Player(s) with the maximum age of a club" />
                        <MenuItem mnemonicParsing="false" onAction="#PressingHeight" style="-fx-text-fill: #1e88e5;" text="Player(s) with the maximum height of a club" />
                        <MenuItem mnemonicParsing="false" onAction="#PressingTotalSalary" style="-fx-text-fill: #1e88e5;" text="Total yearly salary of a club" />
                    </items>
                </Menu>
                <Menu fx:id="addPlayerMenu" mnemonicParsing="false" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Add Player">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#addingPlayer" style="-fx-text-fill: #1e88e5;" text="Add a Player" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Back">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#returnToHome" style="-fx-text-fill: #1e88e5;" text="Return to Home" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>

        <Text layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-fill: #1e88e5;" text="Search Player Menu">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>

            <layoutX>273.0</layoutX>
        </Text>
    </children>
</AnchorPane>
