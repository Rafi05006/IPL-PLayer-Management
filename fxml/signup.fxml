<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="441.0" prefWidth="939.0" style="-fx-background-color: linear-gradient(to bottom, #ffffff, #e3f2fd);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fxml.SignUpController">
   <children>
      <Label layoutX="408.0" layoutY="44.0" style="-fx-text-fill: #1e88e5;" text="Sign Up">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
      <Text layoutX="375.0" layoutY="140.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Club Name :" />
      <TextField fx:id="clubName" layoutX="500.0" layoutY="123.0" style="-fx-border-color: #90caf9; -fx-border-width: 2; -fx-border-radius: 5;" />
      <PasswordField fx:id="Pass" layoutX="500.0" layoutY="175.0" style="-fx-border-color: #90caf9; -fx-border-width: 2; -fx-border-radius: 5;" />
      <PasswordField fx:id="confirmPass" layoutX="500.0" layoutY="228.0" style="-fx-border-color: #90caf9; -fx-border-width: 2; -fx-border-radius: 5;" />
      <Text layoutX="375.0" layoutY="195.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Password :" />
      <Text layoutX="325.0" layoutY="248.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-fill: #1e88e5;" text="Confirm Password :" />
      <Button layoutX="520.0" layoutY="310.0" mnemonicParsing="false" onAction="#performSignUp" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Sign Up" />
      <Button layoutX="400.0" layoutY="310.0" mnemonicParsing="false" onAction="#returntologin" style="-fx-background-color: linear-gradient(to right, #64b5f6, #42a5f5); -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Return" />
   </children>
</AnchorPane>
